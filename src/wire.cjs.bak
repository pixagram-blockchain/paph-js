  parsed.t1 = t1; parsed.t2 = t2;
  parsed.fingerprintId = hex(sha256(fid));
  parsed.extractionProfileId = EXTRACTION_PROFILE + ':' + hex(PROFILE_ID_BYTES).slice(0, 16);
  parsed.detail = { keypoints: kp.list, regionCodes: rfp.codes, maxDim: kp.maxDim,
