/* ================================================================== *
 * 6. hash()
 * ================================================================== */
var DEFAULTS = { foldMatte: true, divideUpscale: true, matteTol: 24, kpCount: MAX_KP };
function hash(a, b, c, opts) {
  if (a && typeof b === 'object' && b !== null && !(b instanceof Uint8Array)) { opts = b; b = undefined; c = undefined; }
  var o = {}; for (var k in DEFAULTS) o[k] = DEFAULTS[k];
  if (opts) for (k in opts) if (opts[k] !== undefined) o[k] = opts[k];

  var img = readImage(a, b, c);
  var W0 = img.w, H0 = img.h, px = img.px, w = img.w, h = img.h;
  if (W0 > 16384 || H0 > 16384 || W0 * H0 > (1 << 24)) throw new RangeError('paph5: image exceeds hash-time limits');
  var flags = 0, scale = 1;
  if (o.foldMatte) { var m = foldMatte(px, w, h, o.matteTol);
    if (m.changed) { px = m.px; flags |= F_MATTE; } }
  if (o.divideUpscale) { scale = upscaleFactor(px, w, h);
    if (scale > 1) { var s = shrink(px, w, h, scale); px = s.px; w = s.w; h = s.h; flags |= F_UPSCALED; } }

  var im = indexImage(px, w, h);
  if (im.opaque < im.idx.length) flags |= F_ALPHA;
  var qmap = new Int32Array(im.idx.length);
  for (var qi = 0; qi < im.idx.length; qi++) qmap[qi] = im.idx[qi] < 0 ? -1 : im.pal[im.idx[qi]].quantile;
  var thumb = thumbnail16(im);
  var flat = true;
  for (var ti = 1; ti < 256; ti++) if (thumb[ti] !== thumb[0]) { flat = false; break; }
  if (flat) flags |= F_FLAT;

  var kp = keypoints(im, o.kpCount);
  var rag = topologySection(im);
  var rfp = regionFingerprints(im, qmap);
  var sk = sketchSection(kp);

  var d = {
    flags: flags, width: W0, height: H0, scale: scale, kpCount: kp.list.length,
    sec: {
      global: hierarchicalDCT(thumb),
      quantile: quantileSection(im, thumb),
      palette: paletteSection(im),
      topology: rag.bytes,
      texture: textureSection(im, qmap),
      regionfp: rfp.bytes,
      spatial: spatialSection(kp),
      coarse: coarseSection(kp),
      sketch: sk.bytes,
      reserved: (function () { var r = new Uint8Array(352); r.set(PROFILE_ID_BYTES); return r; })()
    }
  };
