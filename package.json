{
  "name": "@pixagram/paph-js",
  "version": "4.2.2",
  "description": "PAPH 4.2 \u2014 integer-only perceptual hash and calibrated comparator for pixel-art plagiarism detection. 512 keypoints, diversity-aware geometry, two engines that agree byte for byte.",
  "license": "MIT",
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./wire": {
      "types": "./index.d.ts",
      "import": "./src/wire.js",
      "require": "./src/wire.cjs"
    },
    "./wasm": {
      "types": "./index.d.ts",
      "import": "./wasm/paph-js-wasm.js"
    },
    "./paph.wasm": "./wasm/paph.wasm",
    "./comparator": {
      "types": "./index.d.ts",
      "import": "./src/paph-js.js",
      "require": "./src/paph-js.cjs"
    },
    "./calibration": "./demo/cal-core.cjs",
    "./demo/bench": "./demo/paph4x.html",
    "./demo/console": "./demo/paph-js-console.html"
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "src/",
    "wasm/",
    "rust/",
    "test/",
    "tools/",
    "demo/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/wire.cjs",
    "test:comparator": "node test/comparator.cjs",
    "test:console": "node test/console.mjs",
    "test:bench": "node test/bench.mjs",
    "parity": "node test/parity-wire.mjs",
    "parity:comparator": "node test/parity-comparator.mjs",
    "verify": "node test/wire.cjs && node test/comparator.cjs && node test/console.mjs && node test/bench.mjs",
    "tables": "node tools/tables.cjs",
    "build:bench": "node tools/build-paph4x.mjs",
    "build:wasm": "bash rust/build.sh",
    "example": "node test/example-table.mjs"
  },
  "keywords": [
    "perceptual-hash",
    "pixel-art",
    "plagiarism",
    "copy-detection",
    "wasm",
    "deterministic",
    "nft",
    "paph",
    "image-similarity"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixagram-blockchain/paph-js.git"
  },
  "author": "Pixagram SA",
  "homepage": "https://github.com/pixagram-blockchain/paph-js#readme",
  "bugs": {
    "url": "https://github.com/pixagram-blockchain/paph-js/issues"
  }
}
